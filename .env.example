# Copy to .env and fill in. .env is git-ignored.
CRUSOE_API_KEY=
# Confirm in the Crusoe console; LiteLLM docs list https://managed-inference-api-proxy.crusoecloud.com/v1
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Run `uv run triage ping` to list the model ids your key can use.
CRUSOE_WORKER_MODEL=meta-llama/Llama-3.3-70B-Instruct
CRUSOE_OPTIMIZER_MODEL=deepseek-ai/DeepSeek-V3-0324
# Parallel claims per evaluation run
TRIAGE_WORKERS=8
