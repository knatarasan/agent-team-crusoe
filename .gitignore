# --- Project run outputs (keep playbook/ versioned) ---
# runs/: per-run folders, history.csv, state.json, run.log
# reports/: history.md, dashboard.html (regenerated by `triage history`)
runs/
reports/
# playbook/v1+: configs proposed by runs (each run also snapshots its config in runs/run_NNN/config.yaml)
playbook/v*.yaml
!playbook/v0.yaml
traces/
*.jsonl.tmp
logs/
*.log

